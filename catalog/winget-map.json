  ],
  "never": ["Microsoft.AppInstaller", "Microsoft.UI.Xaml.*", "Microsoft.VCLibs.*", "Microsoft.WindowsAppRuntime.*", "Microsoft.DesktopAppInstaller*"],
  "defaultOff": [
    "Microsoft.Teams", "Microsoft.Teams.*", "Microsoft.365Copilot", "Microsoft.Copilot", "Microsoft.Outlook", "Microsoft.Edge", "Microsoft.Edge.*",
    "Microsoft.OneDrive", "Microsoft.DirectX", "Microsoft.VCRedist.*", "Microsoft.DotNet.*", "Microsoft.WindowsTerminal", "Microsoft.GameInput",
    "XP9CXNGPPJ97XX", "9NHT9RB2F4HD", "9WZDNCRFJ4MV", "9MV0B5HZVK9Z"
  ]
}
