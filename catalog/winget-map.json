{
  "_comment": "Program name (regex on the installed program's DisplayName) -> winget/msstore id. Used when 'winget export' cannot match an installed program (per-user installs, Store apps when the msstore source is off). '$1' in an id is replaced with the first regex group. Every id here was checked with 'winget show --exact'.",
  "map": [
    { "match": "^Google Chrome$", "id": "Google.Chrome", "source": "winget" },
    { "match": "^Discord$", "id": "Discord.Discord", "source": "winget" },
    { "match": "^Steam$", "id": "Valve.Steam", "source": "winget" },
    { "match": "^EA app$", "id": "ElectronicArts.EADesktop", "source": "winget" },
    { "match": "^Epic Games Launcher$", "id": "EpicGames.EpicGamesLauncher", "source": "winget" },
    { "match": "^Rockstar Games Launcher$", "id": "RockstarGames.Launcher", "source": "winget" },
    { "match": "^Ubisoft Connect$", "id": "Ubisoft.Connect", "source": "winget" },
    { "match": "^GOG GALAXY", "id": "GOG.Galaxy", "source": "winget" },
    { "match": "^Battle\\.net$", "id": "Blizzard.BattleNet", "source": "winget" },
    { "match": "^Minecraft Launcher$", "id": "Mojang.MinecraftLauncher", "source": "winget" },
    { "match": "^Spotify$", "id": "Spotify.Spotify", "source": "winget" },
    { "match": "^Mozilla Firefox", "id": "Mozilla.Firefox", "source": "winget" },
    { "match": "^Brave$", "id": "Brave.Brave", "source": "winget" },
    { "match": "^Opera Stable", "id": "Opera.Opera", "source": "winget" },
    { "match": "^Opera GX", "id": "Opera.OperaGX", "source": "winget" },
    { "match": "^Zoom( Workplace)?$", "id": "Zoom.Zoom", "source": "winget" },
    { "match": "^Telegram Desktop", "id": "Telegram.TelegramDesktop", "source": "winget" },
    { "match": "^Python (3\\.1[123])\\.\\d+", "id": "Python.Python.$1", "source": "winget" },
    { "match": "^OBS Studio$", "id": "OBSProject.OBSStudio", "source": "winget" },
    { "match": "^7-Zip ", "id": "7zip.7zip", "source": "winget" },
    { "match": "^VLC media player$", "id": "VideoLAN.VLC", "source": "winget" },
    { "match": "^Notepad\\+\\+", "id": "Notepad++.Notepad++", "source": "winget" },
    { "match": "^WinRAR ", "id": "RARLab.WinRAR", "source": "winget" },
    { "match": "^Git$", "id": "Git.Git", "source": "winget" },
    { "match": "^Microsoft Visual Studio Code", "id": "Microsoft.VisualStudioCode", "source": "winget" },
    { "match": "^WireSock Secure Connect$", "id": "NTKERNEL.WireSockVPNClient", "source": "winget" },
    { "match": "^TeamViewer$", "id": "TeamViewer.TeamViewer", "source": "winget" },
    { "match": "^AnyDesk$", "id": "AnyDesk.AnyDesk", "source": "winget" },
    { "match": "^Logitech G HUB$", "id": "Logitech.GHUB", "source": "winget" },
    { "match": "^Razer Synapse 4", "id": "RazerInc.RazerInstaller.Synapse4", "source": "winget" },
    { "match": "^MSI Afterburner", "id": "Guru3D.Afterburner", "source": "winget" },
    { "match": "^qBittorrent", "id": "qBittorrent.qBittorrent", "source": "winget" },
    { "match": "^blender$", "id": "BlenderFoundation.Blender", "source": "winget" },
    { "match": "^GIMP 3", "id": "GIMP.GIMP.3", "source": "winget" },
    { "match": "^Audacity", "id": "Audacity.Audacity", "source": "winget" },
    { "match": "^ShareX$", "id": "ShareX.ShareX", "source": "winget" },
    { "match": "^PowerToys", "id": "Microsoft.PowerToys", "source": "winget" },
    { "match": "^Docker Desktop$", "id": "Docker.DockerDesktop", "source": "winget" },
    { "match": "^Postman", "id": "Postman.Postman", "source": "winget" },
    { "match": "^Slack", "id": "SlackTechnologies.Slack", "source": "winget" },
    { "match": "^Node\\.js$", "id": "OpenJS.NodeJS.LTS", "source": "winget" },
    { "match": "^Claude$", "id": "Anthropic.Claude", "source": "winget" },
    { "match": "^PowerShell 7", "id": "Microsoft.PowerShell", "source": "winget" },
    { "match": "^WhatsApp$", "id": "9NKSQGP7F2NH", "source": "msstore" },
    { "match": "^iCloud$", "id": "9PKTQ5699M62", "source": "msstore" },
    { "match": "^Disney\\+$", "id": "9NXQXXLFST89", "source": "msstore" },
    { "match": "^Netflix$", "id": "9WZDNCRFJ3TJ", "source": "msstore" },
    { "match": "^Lenovo Vantage$", "id": "9WZDNCRFJ4MV", "source": "msstore" },
